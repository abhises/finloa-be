PORT=4000
DATABASE_URL="postgresql://finloa:finloa@localhost:5435/finloa?schema=public"
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Required in the x-admin-key header for admin endpoints (list/update leads)
ADMIN_API_KEY=change-me-to-a-long-random-string
# Sign-in for the /admin dashboard on the website
ADMIN_EMAIL=admin@finloa.com
ADMIN_PASSWORD=change-me-too
# Optional: secret that signs admin sessions (defaults to one derived from ADMIN_API_KEY)
# AUTH_SECRET=another-long-random-string

# Media library. "local" stores uploads in ./uploads (served at /api/uploads), "s3" uploads to S3_BUCKET.
STORAGE_DRIVER=local
# Public origin of this API, used for local upload URLs (production: https://finloa.com)
PUBLIC_URL=http://localhost:4000
# S3_BUCKET=finloa-media
# S3_REGION=eu-central-1
# S3_PUBLIC_URL=https://cdn.finloa.com
