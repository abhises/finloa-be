generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A monthly video-creation package shown on the pricing section.
model Plan {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  tagline       String
  priceCents    Int
  description   String
  ctaLabel      String
  /// Long-form videos (3–10 min) per month
  longVideos    Int
  /// Shorts (up to 60 s) per month
  shorts        Int
  /// e.g. "Everything in Starter, plus:"
  featuresIntro String?
  features      String[]
  popular       Boolean  @default(false)
  /// Dark card variant in the design
  highlighted   Boolean  @default(false)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leads Lead[]
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

enum Platform {
  YOUTUBE
  TIKTOK
  INSTAGRAM
  LINKEDIN
  FACEBOOK
}

/// A business enquiry submitted from the contact form.
model Lead {
  id             String     @id @default(cuid())
  firstName      String
  lastName       String
  email          String
  company        String?
  website        String?
  videosPerMonth String?
  platforms      Platform[]
  message        String?
  status         LeadStatus @default(NEW)
  /// Page the enquiry came from, e.g. "video-creation", "seo", "for-creators"
  source         String     @default("video-creation")
  planId         String?
  plan           Plan?      @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@index([source])
}

/// Newsletter subscriber from the blog.
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("blog")
  createdAt DateTime @default(now())
}

/// Blog category (replaces the old free-text "topic"). Dutch fields fall back to English when empty.
model Category {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  nameNl    String   @default("")
  intro     String   @default("")
  introNl   String   @default("")
  sortOrder Int      @default(0)
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Blog author, shown in the post header and author box.
model Author {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String   @default("")
  roleNl      String   @default("")
  bio         String   @default("")
  bioNl       String   @default("")
  email       String?
  avatarUrl   String?
  linkedinUrl String?
  youtubeUrl  String?
  websiteUrl  String?
  sortOrder   Int      @default(0)
  posts       Post[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Blog article shown on /blog. Every text field has a Dutch twin (…Nl); empty Dutch fields fall back to English.
model Post {
  id               String    @id @default(cuid())
  slug             String    @unique
  title            String
  titleNl          String    @default("")
  excerpt          String?
  excerptNl        String?
  coverImage       String?
  readMinutes      Int
  /// Article body in Markdown (## headings, lists, links, > quotes)
  body             String    @default("")
  bodyNl           String    @default("")
  /// YouTube video shown at the top of the article
  youtubeId        String?
  /// e.g. "2:48"
  videoLength      String?
  transcript       String?
  transcriptNl     String?
  /// [{ "q": "...", "a": "..." }]
  faqs             Json      @default("[]")
  faqsNl           Json      @default("[]")
  tags             String[]  @default([])
  tagsNl           String[]  @default([])
  seoTitle         String?
  seoTitleNl       String?
  seoDescription   String?
  seoDescriptionNl String?
  /// Extra JSON-LD (structured data) added to the page next to the generated BlogPosting
  jsonLd           String?
  /// Shown large at the top of /blog
  featured         Boolean   @default(false)
  /// Newsletter popup after the reader scrolls 35% down the post
  newsletterPopup  Boolean   @default(false)
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId         String?
  author           Author?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  published        Boolean   @default(true)
  publishedAt      DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([published, publishedAt])
  @@index([categoryId])
}

/// Uploaded file (image, video, PDF) from the media library.
model Media {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  filename  String
  mimeType  String
  size      Int
  alt       String   @default("")
  /// "local" or "s3"
  driver    String
  createdAt DateTime @default(now())
}

/// Edited copy for the hard-coded site pages. `key` is a hash of the default English + Dutch text
/// (see finloa-fe/src/i18n/config.ts). null = use the default from the code.
model SiteText {
  key       String   @id
  en        String?
  nl        String?
  updatedAt DateTime @updatedAt
}

enum VideoKind {
  LONG
  SHORT
}

/// Portfolio video shown in "Our work" on the video page (YouTube only).
model Video {
  id        String    @id @default(cuid())
  /// Industry tab slug, e.g. "software-learning" (see NICHES in src/routes/videos.ts)
  niche     String
  kind      VideoKind
  youtubeId String
  title     String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([niche, kind, active, sortOrder])
}
